# Uraan — environment template. Copy to .env and fill in.
# NEVER commit real secrets. This file contains placeholders only.

# ---------------------------------------------------------------- Database
# Development (this environment): SQLite file. Production: managed Postgres —
# see docs/DEPLOYMENT.md before changing provider; a URL swap alone does NOT
# migrate a SQLite schema or its data.
DATABASE_URL="file:./db/custom.db"

# ---------------------------------------------------------------- Admin
# PUBLIC registration ALWAYS creates a student. ADMIN_EMAILS is advisory
# input for the owner-run CLI only (bun run admin:sync-allowlist); no
# request path reads it. Grant admins on a trusted machine:
#   bun run admin:grant -- owner@yourmail.com
ADMIN_EMAILS=""

# ------------------------------------------------------------ Documents
# Storage adapter: "local" (development default) or "supabase" (production).
# Local mode is REFUSED in production unless explicitly forced.
DOCUMENTS_STORAGE="local"
DOCUMENTS_DIR="./db/private-docs"

# Supabase private object storage (production documents). Create a PRIVATE
# bucket (default name uraan-documents) in your Supabase project dashboard.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
DOCUMENTS_BUCKET="uraan-documents"

# Upload limits
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------- AI
# Server-side only. On hosts WITHOUT a .z-ai-config file (every serverless
# platform — Vercel, Netlify, …) the SDK cannot read credentials from disk;
# set BOTH env vars below or every AI feature degrades to labelled
# template fallbacks (aiGenerated:false):
ZAI_BASE_URL=""
ZAI_API_KEY=""
AI_PROVIDER_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_RUNS_PER_USER=40
AI_DAILY_RUNS_PER_IP=20

# ------------------------------------------------------------ Ingestion
INGESTION_TIMEOUT_MS=10000
INGESTION_MAX_BYTES=524288

# ------------------------------------------------------------ Scheduled
# Shared secret for service-authenticated ingestion triggers (cron). Only
# needed in production; see docs/DEPLOYMENT.md.
INGESTION_CRON_SECRET=""
