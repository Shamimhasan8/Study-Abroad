# Uraan — environment template. Copy to .env and fill in.
# NEVER commit real secrets. This file contains placeholders only.

# SQLite database URL (default: file-based database in db/)
DATABASE_URL="file:./db/custom.db"

# First registered user becomes admin when empty; otherwise comma-separated emails
ADMIN_EMAILS=""

# Private document storage root (owner-scoped subdirectories are created per user)
DOCUMENTS_DIR="./db/private-docs"

# Upload limits
MAX_UPLOAD_MB=5

# AI provider (server-side only; z-ai-web-dev-sdk reads its own config)
AI_PROVIDER_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_RUNS_PER_USER=40

# Ingestion worker
INGESTION_TIMEOUT_MS=10000
INGESTION_MAX_BYTES=524288
